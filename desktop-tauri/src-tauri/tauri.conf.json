{
  "productName": "Agent Orchestrator",
  "version": "0.2.0",
  "identifier": "com.agent-orchestrator.desktop",
  "build": {
    "frontendDist": "../../frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/agent-orch-backend"],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Agent Orchestrator",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:18000 ws://127.0.0.1:18000 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/reasonix/agent-orchestrator/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3ODgyOTZBMjQ5NUU5QkpSV1NiWGttaWxvSjRESmVsMU1EbHpwWnVMdXpXRkFEay8ydkwwZE8wbkxnY0hLeDJibU9oUVFKNgo="
    }
  }
}
