# Agent Orchestrator 环境配置

# DeepSeek API (默认)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com

# Anthropic API (可选)
ANTHROPIC_API_KEY=

# 默认模型
DEFAULT_AI_PROVIDER=deepseek
DEFAULT_AI_MODEL=deepseek-chat

# GitHub (可选，用于 PR 创建)
GITHUB_TOKEN=ghp_xxx
GITHUB_WEBHOOK_SECRET=

# 执行限制
MAX_TOKENS_PER_TASK=500000
TASK_TIMEOUT_SECONDS=1800

# 数据库
# SQLite (默认，适合开发和单机部署)
DATABASE_URL=sqlite+aiosqlite:///./agent_orchestrator.db
# PostgreSQL (生产环境推荐，需安装: pip install agent-orchestrator[postgres])
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_orchestrator

# 服务器
HOST=0.0.0.0
PORT=8000
DEBUG=true
