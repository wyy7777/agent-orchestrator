# =============================================================================
# Agent Orchestrator — 环境变量配置示例
# 复制此文件为 .env 并按需修改
# =============================================================================

# ---- 基本配置 ----
DEBUG=false                          # 调试模式（SQLAlchemy echo 等）
APP_NAME=Agent Orchestrator
APP_VERSION=1.2.0

# ---- 数据库 ----
# SQLite（开发环境）
DATABASE_URL=sqlite+aiosqlite:///./agent_orchestrator.db
# PostgreSQL（生产环境 — Docker Compose 自动使用此格式）
# DATABASE_URL=postgresql+asyncpg://agentorch:agentorch_secret@localhost:5432/agent_orchestrator

# ---- Redis（可选 — 用于缓存和任务队列） ----
REDIS_URL=                                 # redis://localhost:6379/0

# ---- AI API 密钥（至少需要配置一个） ----
# DeepSeek（默认）
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com

# OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-claude-api-key

# Ollama 本地模型（可选 — 支持 llama3/qwen2.5 等本地模型）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# 默认 AI 提供商和模型
DEFAULT_AI_PROVIDER=deepseek          # deepseek | openai | claude | ollama
DEFAULT_AI_MODEL=deepseek-chat        # 或 gpt-4o / claude-sonnet-4-20250514
DEFAULT_MAX_TOKENS=4096

# ---- GitHub 集成（可选） ----
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ---- GitLab 集成（可选） ----
GITLAB_TOKEN=

# ---- Bitbucket 集成（可选） ----
BITBUCKET_TOKEN=

# ---- 执行引擎 ----
MAX_TOKENS_PER_TASK=500000            # 单任务最大 token 消耗
TASK_TIMEOUT_SECONDS=1800             # 任务超时（秒，默认 30 分钟）
STEP_TIMEOUT_SECONDS=300              # 步骤超时（秒，默认 5 分钟）

# ---- API 安全 ----
API_KEY=                              # 可选：客户端 API Key，留空则不验证
CORS_ORIGINS=*                        # 逗号分隔的允许来源

# ---- 速率限制 ----
RATE_LIMIT=60                         # 每窗口最大请求数
RATE_WINDOW=60                        # 时间窗口（秒）

# ---- JWT 认证 ----
SECRET_KEY=                           # 留空则自动生成（重启后令牌失效）
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # Token 过期时间（默认 24 小时）

# ---- SSO / OAuth2（可选） ----
OAUTH2_ENABLED=false
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_MICROSOFT_CLIENT_ID=
OAUTH2_MICROSOFT_CLIENT_SECRET=
OAUTH2_REDIRECT_BASE=http://localhost:8000

# ---- 通知（可选） ----
SLACK_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
WECHAT_WORK_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
NOTIFY_ON_TASK_COMPLETE=true
NOTIFY_ON_TASK_FAIL=true
NOTIFY_ON_APPROVAL_NEEDED=true

# ---- 数据安全 ----
DATA_RETENTION_DAYS=0                 # 0 = 不自动清理，>0 清理 N 天前的数据
ENCRYPTION_KEY=                       # AES-256 密钥，留空则自动生成
ALLOWED_IPS=                          # IP 白名单，逗号分隔的 CIDR，留空不限制

# ---- 服务器 ----
HOST=0.0.0.0
PORT=8000

# ---- 高级选项 ----
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=120
DEFAULT_STEP_TIMEOUT=300
DEFAULT_MAX_ITERATIONS=10
